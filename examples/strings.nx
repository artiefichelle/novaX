/* NOVA-X 0.3: typed strings with static storage. */
fn choose(flag: bool, name: str) -> str {
    if flag { return name; }
    return "NOVA-X";
}

fn main() -> int {
    let greeting: str = "Hallo Welt 🌍";
    var message = choose(true, greeting);
    print(message);
    message = choose(false, greeting);
    print(message);
    print("100% Text: %s wird unverändert ausgegeben.");
    print("Zeile 1\nZeile 2");
    return 0;
}
