// Both functions accept 0..20,000,000 and return -1 outside that domain.
fn checksum_slow(iterations: int) -> int {
    if iterations < 0 || iterations > 20000000 { return -1; }
    let data = [1, 3, 5, 7, 11, 13, 17, 19];
    var i = 0;
    var sum = 0;
    while i < iterations {
        sum = (sum + data[i % 8]) % 1000003;
        i += 1;
    }
    return sum;
}

// Collapse full repetitions, then evaluate at most seven remaining elements.
fn checksum_fast(iterations: int) -> int {
    if iterations < 0 || iterations > 20000000 { return -1; }
    let data = [1, 3, 5, 7, 11, 13, 17, 19];
    var period_sum = 0;
    var i = 0;
    while i < len(data) {
        period_sum += data[i];
        i += 1;
    }
    var total = (iterations / len(data)) * period_sum;
    let remaining = iterations % len(data);
    i = 0;
    while i < remaining {
        total += data[i];
        i += 1;
    }
    return total % 1000003;
}

fn main() -> int {
    print(checksum_fast(20000000));
    return 0;
}
